MONGODB_URL=mongodb://127.0.0.1:27017/highschool
NODE_ENV=development
PORT=5005
HOST=0.0.0.0

# Production: use a long random secret (minimum 32 characters when NODE_ENV=production)
JWT_SECRET=super_secret_key_change_me_use_32plus_chars_in_prod
JWT_ACCESS_EXPIRES_IN=7d

# Comma-separated browser origins, or * (not recommended for production with cookies)
CORS_ORIGIN=http://localhost:3000

# Behind nginx/ALB/load balancer: set true or a positive hop count (e.g. 1)
TRUST_PROXY=false

# JSON request body size cap (e.g. 1mb, 512kb)
JSON_BODY_LIMIT=1mb

# Production only: /api rate limit (per IP per window)
API_RATE_LIMIT_WINDOW_MS=900000
API_RATE_LIMIT_MAX=2000

REDIS_URL=redis://127.0.0.1:6379
OTP_TTL_SECONDS=300
OTP_MAX_VERIFY_ATTEMPTS=5
OTP_MAX_RESEND=3
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_LENGTH=4

SMS_BASE_URL=http://sms.moon.mr:8008
SMS_SEND_PATH=/api/sendsms
SMS_STATISTICS_PATH=/api/sms-statistics
SMS_AUTH_TOKEN=YOUR_TOKEN_HERE
SMS_INCLUDE_TEST_WORD=false

USE_S3=false
AWS_REGION=eu-west-3
AWS_S3_BUCKET=your-bucket
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
PUBLIC_BASE_URL=http://localhost:5005
